---
import { Aside } from "@astrojs/starlight/components";
import { marked } from "marked";
import { getLatestRelease } from "../utils/release";

// The newest entry of the release history page, so that the homepage news
// section follows a new release without being edited alongside it.
const release = getLatestRelease();

const title = release
    ? release.date
        ? `Version ${release.version} - ${release.date}`
        : `Version ${release.version}: ${release.title}`
    : "";

// The entry body is authored in this repository, so rendering it as HTML
// introduces no untrusted markup.
const body = release ? await marked.parse(release.body) : "";
---

{
    release && (
        <Aside icon="rss" title={title}>
            <Fragment set:html={body} />
        </Aside>
    )
}
